# ══════════════════════════════════════════════════════════════
# Python
# ══════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ══════════════════════════════════════════════════════════════
# Ambientes virtuais
# ══════════════════════════════════════════════════════════════
venv/
.venv/
env/
.env/

# ══════════════════════════════════════════════════════════════
# IDE / Editor
# ══════════════════════════════════════════════════════════════
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ══════════════════════════════════════════════════════════════
# Dados de imagem (grandes, não versionados)
# Os arquivos RAW (.NEF) e TIFF podem ter centenas de MB
# ══════════════════════════════════════════════════════════════
data/calibration/raw/*.NEF
data/calibration/raw/*.nef
data/calibration/converted/*.tiff
data/calibration/converted/*.tif

data/sessions/*/raw/**/*.NEF
data/sessions/*/raw/**/*.nef
data/sessions/*/background/**/*.NEF
data/sessions/*/background/**/*.nef
data/sessions/*/converted/**/*.tiff
data/sessions/*/converted/**/*.tif

# Imagens processadas (regeneráveis pelo pipeline)
data/undistorted/
data/masks/

# ══════════════════════════════════════════════════════════════
# Saídas do pipeline (regeneráveis)
# ══════════════════════════════════════════════════════════════
output/annotated/
output/calibration_debug/
output/*.csv

# Manter o arquivo de calibração (pequeno e importante)
!output/calibration_params.yaml

# ══════════════════════════════════════════════════════════════
# Pytest
# ══════════════════════════════════════════════════════════════
.pytest_cache/
tests/_tmp/

# ══════════════════════════════════════════════════════════════
# OS
# ══════════════════════════════════════════════════════════════
Thumbs.db
.DS_Store
Desktop.ini
